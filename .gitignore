.venv/
__pycache__/
*.pyc

# Voice models: large binaries, and some (lessac, lanfrica) carry licenses that
# forbid redistribution. Never commit these.
voices/**/*.onnx
voices/**/*.onnx.json

# Generated audio trees. Never commit these: ~1.5 GB per language, and they
# are reproducible from the text plus the voice model. A specific-name rule
# missed audio_v2/ once, so match the prefix instead -- this also covers
# audio_en/ and any future language tree.
audio*/
*.wav
*.m4a

.env

# Diagnostic scans. Point-in-time reports about a corpus that gets replaced,
# so they go stale immediately and are cheap to regenerate.
corrupt_chapters.json
corruption_report.json
en_noise_scan.json
