# Copy to .env for local runs, or set these in Coolify. Never commit .env.

# REQUIRED. Comma-separated. Generate with: openssl rand -hex 32
# The stack refuses to start without this, so it can never run unauthenticated.
API_KEYS=

LOG_LEVEL=INFO

# --- piper engine ---
# Compose service name on the internal network. There is no external network to
# configure: both containers live in the same stack.
PIPER_URL=http://piper:5000
PIPER_TIMEOUT_S=300
# Voices the engine downloads into its volume. First entry is its default.
PIPER_VOICES=en_US-lessac-medium sw_CD-lanfrica-medium

# --- voice selection ---
# JSON. "{language}:{translation}" takes precedence over "{language}", so one
# translation can have its own narrator. Nothing is inferred from the text.
# VOICES={"en":"en_US-lessac-medium","sw":"sw_CD-lanfrica-medium","en:kjv":"en_US-libritts-high"}
DEFAULT_LANGUAGE=en
# JSON. Translation used when a request omits ?translation=
# DEFAULT_TRANSLATIONS={"en":"kjv","sw":"swh"}

# Narration speed. length_scale > 1.0 slows delivery; Piper's default is
# ~224 wpm, against the 150-160 wpm typical of audiobooks.
LENGTH_SCALE=1.0
# Bump to invalidate every cached file after changing a voice.
VOICE_REVISION=v1

# --- limits ---
MAX_TTS_CHARS=600
MAX_CONCURRENT_SYNTHESIS=1
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_S=60

# --- storage (paths inside the container; both are named volumes) ---
AUDIO_DIR=/data/audio
BIBLE_DATA_DIR=/app/data/bible
AUDIO_FORMAT=m4a
AUDIO_BITRATE=48k

# Only needed if a browser client calls the API; the mobile app does not.
CORS_ORIGINS=
