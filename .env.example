# Copy to .env and fill in. Never commit .env.

# Comma-separated. Generate with: openssl rand -hex 32
# Leave empty ONLY for local development; empty disables authentication.
API_KEYS=

LOG_LEVEL=INFO

# Piper engine, reachable on the internal Docker network only.
PIPER_URL=http://piper:5000
PIPER_TIMEOUT_S=300

# Narration. length_scale > 1.0 slows delivery; Piper's default is ~224 wpm,
# against the 150-160 wpm typical of audiobooks.
LENGTH_SCALE=1.0
DEFAULT_LANGUAGE=en
# Bump to invalidate every cached file after changing a voice.
VOICE_REVISION=v1

# Limits
MAX_TTS_CHARS=600
MAX_CONCURRENT_SYNTHESIS=1
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_S=60

# Storage
AUDIO_DIR=/data/audio
BIBLE_DATA_DIR=/app/data/bible
AUDIO_FORMAT=m4a
AUDIO_BITRATE=48k

# Only needed if a browser client calls the API; the mobile app does not.
CORS_ORIGINS=
